# Copy this file to .env and fill in real values. Never commit .env.
GROQ_API_KEY=gsk_your_key_here
LLM_MODEL=openai/gpt-oss-120b
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# 0 = disabled. Set after running calibrate_threshold.py.
MAX_DISTANCE=0
# Leave empty to let Streamlit call the RAG code directly.
# Set to your FastAPI URL (e.g. http://127.0.0.1:8000) to route through the API.
API_URL=
